{
  "expo": {
    "name": "MichiNica",
    "slug": "michinica",
    "version": "1.0.0",
    "orientation": "portrait",

    "icon": "./assets/icon.png", 
    "userInterfaceStyle": "light",

    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },

    "android": {
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "package": "com.kennet29.MichiNica",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      },
      "versionCode": 1
    },

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kennet29.MichiNica",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Necesitamos tu ubicación para mostrar el mapa."
      },
      "buildNumber": "1.0.0"
    },

    "plugins": [
      "expo-font",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Tu ubicación se usa para mostrar el mapa y tu recorrido.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ]
    ],

    "extra": {
      "eas": {
        "projectId": "b131a3ee-be28-4319-b6c2-f3434a280cb3"
      }
    }
  }
}
